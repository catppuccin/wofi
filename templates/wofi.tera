---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
    - accent
  filename: "themes/{{ flavor.identifier }}/{{ flavor.identifier }}-{{ accent }}.css"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* Catppuccin {{ flavor.name }} - Wofi */
* {
  font-size: 18px;
}
#scroll {
  background-color: {{ base.hex }};
}
#outer-box {
  background-color: {{ base.hex }};
  padding: 10px;
  border: 2px solid {{ flavor.colors[accent].hex }};
}
#main {
  background-color: {{ base.hex }};
}
scrollbar,
scrollbar trough,
undershoot.top,
undershoot.bottom {
  min-width: 5px;
  min-height: 5px;
  background: none;
}
scrollbar slider{
  background-color: {{ flavor.colors[accent].hex }};
}
#outer-box {
  padding: 10px;
}

#input image {
  color: {{ flavor.colors[accent].hex }};
  -gtk-icon-effect: none;
}
#input {
  background-color: {{ surface0.hex }};
  color: {{ text.hex }};
  caret-color: {{ flavor.colors[accent].hex }};
  border: 1px solid {{ surface1.hex }};
  padding: 8px 12px;
  margin: 10px;
  border-radius: 35px;
  outline: 1px solid {{ surface2.hex }};
}
#input:focus {
  border-color: {{ flavor.colors[accent].hex }};
}
#input placeholder {
  color: {{ base.hex }};
}
#entry {
  background-color: {{ base.hex }};
  color: {{ text.hex }};
}
#entry #entry:selected {
  background-color: {{ surface0.hex }};
  color: {{ flavor.colors[accent].hex }};
}
#entry:selected {
  background-color: {{ surface0.hex }};
  color: {{ flavor.colors[accent].hex }};
}
#entry:hover {
  background-color: {{ surface1.hex }};
}
#text {
  color: {{ text.hex }} ;
}
#text:selected {
  color: {{ flavor.colors[accent].hex }};
}
